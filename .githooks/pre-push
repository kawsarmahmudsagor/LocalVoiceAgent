#!/bin/sh
# Scan every commit about to be pushed. Backstop for commits made with --no-verify.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found. Install it (winget install Gitleaks.Gitleaks) and retry." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion: nothing to scan
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"            # new branch: commits not on any remote
  else
    range="$remote_sha..$local_sha"
  fi
  gitleaks git --redact --no-banner --config .gitleaks.toml --log-opts="$range" . || status=1
done

if [ $status -ne 0 ]; then
  echo "pre-push: gitleaks found possible secrets in commits being pushed. Push blocked." >&2
  echo "Rewrite the offending commit(s) to remove the secret, and rotate it." >&2
fi
exit $status
