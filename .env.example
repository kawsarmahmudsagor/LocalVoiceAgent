# Local voice bot settings. Copy to .env and edit. Changes apply on restart.

# LLM backend: transformers (HF 4-bit, in process) or llamacpp (llama-server + GGUF)
LLM_BACKEND=llamacpp
# Audio I/O: browser (browser mic + speaker) or server (this PC's mic + speaker; not on Linux)
AUDIO_IO=browser

# --- transformers backend ---
# Hugging Face model id (19.3 GB download on first run)
HF_MODEL_ID=Qwen/Qwen3.5-9B
# Load with bitsandbytes NF4 4-bit quantization
HF_LOAD_IN_4BIT=true

# --- llamacpp backend ---
# true: the app starts and stops llama-server itself; false: connect to LLAMA_BASE_URL
LLAMA_AUTOSTART=true
# How llama-server runs: docker (Linux default) or binary (Windows default)
# LLAMA_RUNTIME=docker
# Docker image for LLAMA_RUNTIME=docker (use voicebot/llama-server:cuda12.8 if the official one lacks sm_120)
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# llama-server binary for LLAMA_RUNTIME=binary (relative paths resolve against the repo root)
LLAMA_SERVER_PATH=tools/llama/llama-server.exe
# GGUF repo and quant passed to llama-server -hf (5.7 GB download on first run)
LLAMA_HF_REPO=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# llama-server listen address
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8081
# LLAMA_BASE_URL is derived from LLAMA_HOST/LLAMA_PORT unless set
# LLAMA_BASE_URL=http://127.0.0.1:8081
# Context size (-c)
LLAMA_CTX=8192
# Seconds to wait for llama-server to become healthy (first run downloads the model)
LLAMA_START_TIMEOUT=900

# --- v2 model selection (slugs from server/voicebot/catalog.toml; switchable in the UI) ---
# Startup final STT slug
STT_FINAL=whisper-small-en
# Startup realtime STT slug, or off
STT_REALTIME=off
# Startup TTS slug
TTS_MODEL=kokoro
# VRAM meter: total GPU memory (RTX 5090) and the LLM's estimate (Q4_K_M, 8k context), in MB
GPU_TOTAL_MB=32607
LLM_VRAM_MB=7000

# --- speech to text (RealtimeSTT / faster-whisper); v1 fallback used only without catalog.toml ---
# faster-whisper model
STT_MODEL=small.en
# cuda or cpu (cpu frees VRAM for the LLM)
STT_DEVICE=cuda
# int8, float16, ...
STT_COMPUTE_TYPE=int8
# Seconds of silence that end a spoken turn
STT_SILENCE_SEC=0.6

# --- text to speech (RealtimeTTS / Kokoro on CPU) ---
# Kokoro voice
TTS_VOICE=af_heart

# --- TTS pacing (logged with every turn, so latency_report --by can compare them) ---
# Kokoro trims silence around every sentence fragment by default, which removes the pauses
# after commas and full stops. false keeps the natural pauses.
KOKORO_TRIM_SILENCE=false
# With KOKORO_TRIM_SILENCE=true: milliseconds of pause kept at the end of each fragment
KOKORO_EXTRA_END_MS=200
# Start speaking after this many words even if no punctuation has arrived yet (RealtimeTTS default: 30).
# A low value cuts the first sentence mid-phrase, which sounds like a pause in mid-sentence.
TTS_FIRST_FRAGMENT_WORDS=30
# true: speak the first sentence's opening fragment (up to its first comma) on its own. Speech starts sooner,
# but with a pause and a pitch reset mid-sentence. false: synthesize whole sentences only.
TTS_FAST_SENTENCE_FRAGMENT=false
# Extra pause after each sentence, in milliseconds
TTS_SENTENCE_SILENCE_MS=0
# Kokoro speaking rate (1.0 = normal; 0.9-0.95 sounds less rushed)
KOKORO_SPEED=1.0

# --- generation defaults (editable in the UI) ---
# System prompt
SYSTEM_PROMPT="You are a friendly voice assistant. Reply in one to three short spoken sentences. Never use lists, markdown, code blocks or emoji. Write numbers, units and abbreviations as words, the way you would say them."
# Sampling temperature
LLM_TEMPERATURE=0.7
# Nucleus sampling
LLM_TOP_P=0.8
# Max new tokens per reply
LLM_MAX_TOKENS=256
# User+assistant pairs kept in history
HISTORY_TURNS=10

# --- web server ---
# FastAPI listen address
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Optional HTTPS: set both (relative paths resolve against the repo root), e.g. certs/cert.pem and certs/key.pem
WEB_SSL_CERTFILE=
WEB_SSL_KEYFILE=

# Benchmark clip recording (v2 Phase A): save each spoken turn as bench/clips/clip-NNN.wav. Empty = off
CLIP_RECORD_DIR=
